# Nexora Root Environment Configuration Template
# Copy this file to .env in backend/ and ml-service/ as directed.

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET=super_secret_local_dev_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=local_cookie_signing_secret_123

# ML Service URL
ML_SERVICE_URL=http://127.0.0.1:8000

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
